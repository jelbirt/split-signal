# Environments
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Data caches (regenerable; fixtures under data/fixtures/ ARE committed)
# No trailing slash on data/raw: in a worktree it is a SYMLINK to the main
# checkout's cache (see scripts/new-worktree.sh), and a "dir/" pattern does
# not match a symlink — which would leave every worktree permanently dirty
# and un-teardownable.
data/raw
data/processed/

# Notebook noise
notebooks/.ipynb_checkpoints/
.ipynb_checkpoints/

# Local scratch
*.log
